# .env.default — Safe default values for local development.
# No secrets — placeholder values only.
# The start scripts copy this to .env if .env does not already exist.
# This file IS committed to version control.

# ── Backend ───────────────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=8080
UVICORN_WORKERS=1

# Placeholder — replaced with a real secret on first run or in production
WEBUI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

CORS_ALLOW_ORIGIN=http://localhost:3000;http://localhost:8080
FORWARDED_ALLOW_IPS=*

DATABASE_URL=sqlite:///./data/webui.db
DATA_DIR=./data
REDIS_URL=

ENV=prod
DOCKER=false
GLOBAL_LOG_LEVEL=INFO

SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

WEBUI_AUTH=true
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# ── Frontend ──────────────────────────────────────────────────────────────────

# Empty = Docker mode (nginx proxies backend internally)
# Set to http://127.0.0.1:8080 for local non-Docker dev
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_VERSION=0.8.8
NEXT_PUBLIC_APP_BUILD_HASH=dev-build

# ── Shared / Docker infrastructure ────────────────────────────────────────────

BODHION_PORT=80
IMAGE_NAME=bodhion
IMAGE_TAG=latest
BUILD_HASH=local-build

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# ── RAG / Embeddings ──────────────────────────────────────────────────────────

# Embedding engine — empty = local sentence-transformers (downloads from HuggingFace).
# Set to "ollama" to use Ollama instead (no internet required).
# RAG_EMBEDDING_ENGINE=ollama
# RAG_EMBEDDING_MODEL=nomic-embed-text

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
#
# Leave CHROMA_HTTP_HOST empty to use the local persistent store at
# backend/data/vector_db/ (default for all environments).
# Set it to a remote Chroma server hostname/IP to use an external instance.
#
CHROMA_HTTP_HOST=
# CHROMA_HTTP_PORT=8000
# CHROMA_HTTP_SSL=false
# CHROMA_HTTP_HEADERS=
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database
# CHROMA_CLIENT_AUTH_PROVIDER=
# CHROMA_CLIENT_AUTH_CREDENTIALS=

# ── Bodhion Native Extractor ─────────────────────────────────────────────────

# Write extracted Markdown to backend/data/bodhion-extractor/<timestamp>/<filename>/
# Values: true | false  — default (empty/unset) = disabled
BODHION_EXTRACTOR_WRITE_OUTPUT=

# ── MCP Bundled Servers ───────────────────────────────────────────────────────
# Set to true to auto-register the bundled MCP servers (filesystem, sqlite, fetch)
# at startup. Requires launching the mcp-bundled Docker Compose profile:
#   docker compose --profile mcp-bundled up -d
ENABLE_BUNDLED_MCP_SERVERS=false

# ── MCP Observability ─────────────────────────────────────────────────────────
MCP_HEALTH_CHECK_INTERVAL_SECONDS=60
MCP_HEALTH_HISTORY_RETENTION_DAYS=7
MCP_SERVER_DOWN_ALERT_THRESHOLD=3
