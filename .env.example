# .env.example — All environment variables used by this project.
# Copy to .env and fill in real values.  This file is safe to commit.
# Do NOT commit .env — it is already in .gitignore.
#
# Usage:
#   cp .env.example .env          # then edit .env with real secrets
#   OR let a start script do it:  scripts/start.sh / start.ps1 / start.bat

# ── Backend ──────────────────────────────────────────────────────────────────

# uvicorn bind host — keep 0.0.0.0 in Docker; use 127.0.0.1 for local-only
HOST=0.0.0.0

# uvicorn bind port
PORT=8080

# Number of uvicorn worker processes (increase for multi-core; requires Redis for session sharing)
UVICORN_WORKERS=1

# JWT signing secret — MUST be changed in production.
# Generate a safe value: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Ollama API base URL.
# Docker on Windows/Mac: http://host.docker.internal:11434
# Docker on Linux:       http://172.17.0.1:11434  (or your host IP)
# Local dev:             http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI-compatible API base URL (leave empty to disable)
OPENAI_API_BASE_URL=

# OpenAI API key (leave empty if not using OpenAI)
OPENAI_API_KEY=

# ── Claude Extended Thinking ──────────────────────────────────────────────────

# Enable Anthropic extended thinking (chain-of-thought) for Claude models.
# Only activates when the model endpoint URL contains api.anthropic.com.
ENABLE_CLAUDE_THINKING_API=false

# Token budget for Claude's thinking block (default: 8000, max: ~16000).
# Higher values allow deeper reasoning but increase latency and cost.
CLAUDE_THINKING_BUDGET_TOKENS=8000

# CORS allowed origins — semicolon-separated list.
# Use * only in development; lock down in production.
CORS_ALLOW_ORIGIN=http://localhost:3000;http://localhost:8080

# Trusted proxy IPs for X-Forwarded-For header.
# Use * when behind a known reverse proxy (nginx/traefik).
FORWARDED_ALLOW_IPS=*

# Database connection string.
# SQLite (default):  sqlite:///./data/webui.db
# PostgreSQL:        postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/webui.db

# Root directory for persistent data (SQLite DB, uploads, vector_db, cache).
# In Docker this path lives inside the container; mount a named volume here.
DATA_DIR=./data

# Run Alembic migrations automatically on startup (recommended: true).
# When true, new DB columns are added without any manual `alembic upgrade head`.
ENABLE_DB_MIGRATIONS=true

# Redis URL for multi-worker session sharing (leave empty for single-worker SQLite)
REDIS_URL=

# Application environment mode
ENV=prod

# Set to true when running inside Docker (env.py uses this to adjust paths)
DOCKER=false

# Log verbosity: DEBUG | INFO | WARNING | ERROR
GLOBAL_LOG_LEVEL=INFO

# Analytics / telemetry — disable in enterprise
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Enable authentication (always true in production)
WEBUI_AUTH=true

# Auto-create an admin account on first startup (leave empty to skip)
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# ── Frontend ─────────────────────────────────────────────────────────────────

# Backend URL used by the Next.js server for its /api, /ollama, /ws rewrites.
# Leave EMPTY in Docker — nginx proxies those paths directly to the backend service.
# Set to http://127.0.0.1:8080 for local non-Docker development.
NEXT_PUBLIC_API_URL=

# App version shown in the UI (should match frontend/package.json)
NEXT_PUBLIC_APP_VERSION=0.8.8

# Build hash — injected by CI/CD pipelines; safe to leave as dev-build locally
NEXT_PUBLIC_APP_BUILD_HASH=dev-build

# ── Shared / Docker infrastructure ───────────────────────────────────────────

# Host port mapped to the nginx frontend container (what the browser hits)
BODHION_PORT=80

# Docker image name and tag (used by docker compose build / docker pull)
IMAGE_NAME=bodhion
IMAGE_TAG=latest

# Optional build label embedded in the image
BUILD_HASH=local-build

# Corporate proxy — set only if your network requires it (build-time + runtime)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# ── RAG / Embeddings ─────────────────────────────────────────────────────────
#
# RAG_EMBEDDING_ENGINE controls which backend generates text embeddings for
# document ingestion and semantic search.
#
# ┌─────────────────┬────────────────────────────────────────────────────────┐
# │ Value           │ Description                                            │
# ├─────────────────┼────────────────────────────────────────────────────────┤
# │ (empty/unset)   │ Local sentence-transformers. Downloads the model from  │
# │                 │ HuggingFace Hub on first run. Requires internet and    │
# │                 │ valid SSL certificates.                                │
# ├─────────────────┼────────────────────────────────────────────────────────┤
# │ ollama          │ Uses an Ollama server. No internet required after      │
# │                 │ pulling the model. Recommended for offline/corporate   │
# │                 │ deployments. Defaults to OLLAMA_BASE_URL if            │
# │                 │ RAG_OLLAMA_BASE_URL is unset.                          │
# ├─────────────────┼────────────────────────────────────────────────────────┤
# │ openai          │ Uses the OpenAI embeddings API (or any compatible      │
# │                 │ endpoint). Requires RAG_OPENAI_API_KEY.                │
# └─────────────────┴────────────────────────────────────────────────────────┘
#
# --- Option A: Ollama (recommended — no HuggingFace / no SSL issues) ----------
# RAG_EMBEDDING_ENGINE=ollama
# RAG_EMBEDDING_MODEL=nomic-embed-text
#   Pull first: ollama pull nomic-embed-text
# RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
#   Defaults to OLLAMA_BASE_URL above if unset.
# RAG_OLLAMA_API_KEY=
#   Leave empty unless your Ollama instance requires a key.
#
# --- Option B: OpenAI embeddings ----------------------------------------------
# RAG_EMBEDDING_ENGINE=openai
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_OPENAI_API_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=sk-...
#
# --- Option C: local sentence-transformers (default when engine is empty) -----
# RAG_EMBEDDING_ENGINE=
# RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#   Downloads from HuggingFace on first run. Set REQUESTS_CA_BUNDLE if behind
#   a corporate SSL-inspection proxy. Disable only in dev (not production):
#   HF_HUB_DISABLE_SSL_VERIFICATION=1
#
# --- Shared tuning knobs (apply to all engines) -------------------------------
# RAG_EMBEDDING_BATCH_SIZE=1
# RAG_EMBEDDING_CONCURRENT_REQUESTS=0   # 0 = no limit
# RAG_EMBEDDING_QUERY_PREFIX=           # optional prefix added to query text
# RAG_EMBEDDING_CONTENT_PREFIX=         # optional prefix added to document text

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
#
# By default the app uses a local persistent ChromaDB instance stored at:
#   backend/data/vector_db/
#
# To connect to a remote ChromaDB HTTP server instead, set CHROMA_HTTP_HOST.
# When CHROMA_HTTP_HOST is set, the local data/vector_db/ folder is NOT used.
#
# CHROMA_HTTP_HOST        — hostname or IP of the remote Chroma server.
#                           Leave empty to use the local persistent store (default).
# CHROMA_HTTP_PORT        — HTTP port of the remote Chroma server (default: 8000).
# CHROMA_HTTP_SSL         — set to "true" to use HTTPS (default: false).
# CHROMA_HTTP_HEADERS     — optional JSON object of extra HTTP headers, e.g.
#                           '{"Authorization": "Bearer <token>"}'
# CHROMA_TENANT           — Chroma tenant name (default: "default_tenant").
# CHROMA_DATABASE         — Chroma database name (default: "default_database").
# CHROMA_CLIENT_AUTH_PROVIDER    — auth provider class, e.g.
#                                  chromadb.auth.token.TokenAuthClientProvider
# CHROMA_CLIENT_AUTH_CREDENTIALS — credentials string for the auth provider.
#
CHROMA_HTTP_HOST=
# CHROMA_HTTP_PORT=8000
# CHROMA_HTTP_SSL=false
# CHROMA_HTTP_HEADERS=
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database
# CHROMA_CLIENT_AUTH_PROVIDER=
# CHROMA_CLIENT_AUTH_CREDENTIALS=

# ── Reranking ────────────────────────────────────────────────────────────────
#
# Reranking re-scores the initial vector/hybrid retrieval candidates so the
# most relevant chunks reach the LLM first. It only takes effect when
# Hybrid Search is enabled (ENABLE_RAG_HYBRID_SEARCH=true).
#
# RAG_TOP_K controls the candidate pool fed into the reranker.
# Set it much larger than RAG_TOP_K_RERANKER so the reranker has room to work.
# Example: retrieve 20 candidates, rerank, return the best 5.
#
# ┌─────────────────────────┬────────────────────────────────────────────────┐
# │ RAG_RERANKING_ENGINE    │ Description                                    │
# ├─────────────────────────┼────────────────────────────────────────────────┤
# │ (empty/unset)           │ Option A — Local SentenceTransformers          │
# │                         │ CrossEncoder. Model auto-downloaded from       │
# │                         │ HuggingFace Hub on first run.                  │
# ├─────────────────────────┼────────────────────────────────────────────────┤
# │ external                │ Option C — External HTTP reranker. Compatible  │
# │                         │ with HuggingFace TEI (/rerank endpoint) and    │
# │                         │ Cohere Rerank API. Requires                    │
# │                         │ RAG_EXTERNAL_RERANKER_URL.                     │
# └─────────────────────────┴────────────────────────────────────────────────┘
#
# --- Option A: Local CrossEncoder (no extra service required) -----------------
# RAG_RERANKING_ENGINE=
# RAG_RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#   Other choices (larger = better quality, slower):
#     cross-encoder/ms-marco-MiniLM-L-12-v2   (133 MB, better quality)
#     BAAI/bge-reranker-v2-m3                 (568 MB, best quality, GPU recommended)
#
# --- Option C: External TEI / Cohere (run docker/docker-compose.reranker.yml) -
# RAG_RERANKING_ENGINE=external
# RAG_RERANKING_MODEL=BAAI/bge-reranker-v2-m3
# RAG_EXTERNAL_RERANKER_URL=http://localhost:8080/rerank
# RAG_EXTERNAL_RERANKER_API_KEY=
#   Leave empty for TEI. Set to your Cohere API key for Cohere Rerank.
#   Cohere URL: https://api.cohere.com/v1/rerank
#   Cohere model: rerank-v3.5
# RAG_EXTERNAL_RERANKER_TIMEOUT=30
#
# --- Shared tuning knobs (apply to both options) ------------------------------
# RAG_TOP_K=20                  # candidate pool — increase when reranking is on
# RAG_TOP_K_RERANKER=5          # final results returned after reranking
# RAG_RELEVANCE_THRESHOLD=0.0   # drop docs below this score (0.0 = keep all)

# ── Bodhion Native Extractor ─────────────────────────────────────────────────

# When true, the extractor writes each page as a .md file plus a _full.md to:
#   backend/data/bodhion-extractor/<MMDDYYYYHHMMSS>/<pdf-filename>/
# Useful for inspecting extraction quality. Off by default in all environments.
# Values: true | 1 | yes  to enable — anything else (or unset) = disabled
BODHION_EXTRACTOR_WRITE_OUTPUT=
