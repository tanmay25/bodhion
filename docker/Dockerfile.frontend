# docker/Dockerfile.frontend
# Next.js frontend — pure Node.js runtime (no nginx).
# Use this image if you want to run the frontend without a reverse proxy,
# or place it behind an external load balancer / TLS terminator.
# For the production nginx variant (recommended) use Dockerfile.frontend.nginx.
#
# Build context: project root (mti-mindai-main/)
# Build:   docker build -f docker/Dockerfile.frontend -t bodhion_frontend .
# Run via: docker compose -f docker/docker-compose.yml up frontend

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first (layer-cached unless package files change)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy source and build
# NEXT_PUBLIC_API_URL is intentionally left empty here; in Docker the nginx
# proxy handles routing, so the Next.js server never needs to call the backend
# URL directly from the browser bundle.
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser  --system --uid 1001 nextjs

# Copy the minimal standalone output produced by output: 'standalone'
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
# Static assets (JS chunks, CSS, images) — served by Next.js or nginx
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# Public directory (favicon, images, fonts, manifest)
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/ || exit 1

# server.js is the standalone entrypoint generated by Next.js
CMD ["node", "server.js"]
